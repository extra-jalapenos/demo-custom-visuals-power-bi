{
    "dataRoles": [
        {
            "displayName": "Date",
            "name": "dateField",
            "kind": "Grouping"
        },
        {
            "displayName": "Series",
            "name": "seriesField",
            "kind": "Grouping"
        },
        {
            "displayName": "Value",
            "name": "value",
            "kind": "Measure"
        }
    ],
    "objects": {
        "dataPoint": {
            "properties": {
                "defaultColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "showAllDataPoints": {
                    "type": {
                        "bool": true
                    }
                },
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fillRule": {
                    "type": {
                        "fill": {}
                    }
                },
                 "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "maxOpacity": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "dateField": { "max": 1, "min": 1 },
                    "seriesField": { "min": 1 },
                    "value": { "min": 1, "max": 1 }
                }
            ],
            "categorical": {
                "categories": {
                    "for":{
                        "in": "dateField"
                    },
                    "dataReductionAlgorithm": {
                        "top": { "count": 1000 }
                    }
                },
                "values": {
                    "group": {
                        "by": "seriesField",
                        "select": [{
                            "for": {
                                "in": "value"
                            }
                        }]
                    }
                }
            }
        }
    ],
    "privileges": []
}
